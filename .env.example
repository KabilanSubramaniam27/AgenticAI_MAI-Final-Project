# Ingestion settings are namespaced to coexist with agent/provider settings.
TRIPRADAR_EMBEDDING_FUNCTION=chroma_default
TRIPRADAR_EMBEDDING_MODEL=all-MiniLM-L6-v2
TRIPRADAR_EMBEDDING_DIMENSION=384
TRIPRADAR_EMBEDDING_BATCH_SIZE=32
TRIPRADAR_EMBEDDING_SPACE_VERSION=chroma-minilm-v1
TRIPRADAR_CHUNK_TARGET_TOKENS=180
TRIPRADAR_CHUNK_OVERLAP_TOKENS=24
TRIPRADAR_CHUNK_MAX_INPUT_TOKENS=256
TRIPRADAR_CHROMA_PERSIST_DIRECTORY=data/chroma_db
TRIPRADAR_CHROMA_COLLECTION=tripradar_destinations
TRIPRADAR_HTTP_TIMEOUT_SECONDS=30
TRIPRADAR_HTTP_MAX_RETRIES=4
TRIPRADAR_HTTP_INTERVAL_SECONDS=1
# Replace with your project URL or contact address before repeated public collection.
TRIPRADAR_SCRAPER_USER_AGENT=TripRadarIngestion/0.1 (local research; contact not configured)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=tripradar-ingestion
# Keep ingestion traces separate when a shared .env contains another project.
TRIPRADAR_LANGSMITH_PROJECT=tripradar-ingestion
LANGSMITH_WORKSPACE_ID=
# Optional cloud copy (local ingestion continues using data/chroma_db).
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=DEV

# Agent vertical slice (separate from ingestion). Never commit real credentials.
TRIPRADAR_AGENT_MODE=live
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
# Optional overrides; otherwise LLM_MODEL applies to every role.
# TRIPRADAR_AGENT_MODEL=gpt-4o-mini
# TRIPRADAR_AGENT_SPECIALIST_MODEL=gpt-4o-mini
TRIPRADAR_AGENT_CHROMA_BACKEND=cloud
TRIPRADAR_AGENT_CHROMA_COLLECTION=cloud_tripradar_destinations_6d212e1068573a49
# Set conservative upper rates across both configured models from your account rate card.
# Defaults cover GPT-4o mini standard text pricing; update for custom models.
TRIPRADAR_AGENT_INPUT_USD_PER_MILLION=0.15
TRIPRADAR_AGENT_OUTPUT_USD_PER_MILLION=0.60
TRIPRADAR_AGENT_REQUEST_COST_CAP=2

# Opt-in redacted agent observability; independent of ingestion tracing.
TRIPRADAR_AGENT_LANGSMITH_TRACING=false
TRIPRADAR_AGENT_LANGSMITH_PROJECT=tripradar-agents
# Reuses LANGSMITH_API_KEY / ENDPOINT / WORKSPACE_ID above by default.
# Optional agent-only overrides (omit if using the shared credentials):
# TRIPRADAR_AGENT_LANGSMITH_API_KEY=
# TRIPRADAR_AGENT_LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# TRIPRADAR_AGENT_LANGSMITH_WORKSPACE_ID=

# Read-only flight/hotel pricing. Explicit test mode is never labeled production-live.
TRIPRADAR_AGENT_AMADEUS_ENVIRONMENT=test
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# Frankfurter ECB FX needs no key. No booking/payment endpoints are implemented.

# Optional read-only account/model visibility probes at API startup (no completion requested).
TRIPRADAR_AGENT_STARTUP_MODEL_PROBES=false
# Background monitoring stays disabled until a human-calibrated acceptance report passes.
TRIPRADAR_AGENT_JUDGE_TRACKING=false
TRIPRADAR_AGENT_JUDGE_ACCEPTANCE_PATH=data/evals/judge-acceptance.json
